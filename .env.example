# PostgreSQL connection URL.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE

# Long random secret used to sign authentication cookies.
JWT_SECRET=replace_with_a_secure_random_secret

# Comma-separated browser origins allowed to use cookie credentials.
FRONTEND_ORIGINS=http://localhost:3000

# Optional Gemini API Key (if AI features are used)
GEMINI_API_KEY=
